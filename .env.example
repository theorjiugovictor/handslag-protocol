# Settlement Network - Environment Variables
# Copy to .env and fill in real values

# Database
DATABASE_URL="file:./dev.db"

# Zwapgrid API
ZWAPGRID_API_KEY="your-zwapgrid-api-key-here"
ZWAPGRID_CONSENT_ID=""
# Optional: use separate accepted consents when supplier and buyer connect to different ERPs
ZWAPGRID_SUPPLIER_CONSENT_ID=""
ZWAPGRID_BUYER_CONSENT_ID=""
# Required for real-mode demo matching when the invoice reference is not the seeded demo value
ZWAPGRID_SUPPLIER_INVOICE_REFERENCE=""
ZWAPGRID_BUYER_INVOICE_REFERENCE=""

# Open Payments (PSD2)
OPEN_PAYMENT_CLIENT_ID="your-client-id-here"
OPEN_PAYMENT_CLIENT_SECRET="your-client-secret-here"
OPEN_PAYMENT_AUTH_HOST="auth.openbankingplatform.com"
OPEN_PAYMENT_API_HOST="api.openbankingplatform.com"

# Open Payments mode (independent from Zwapgrid)
INTEGRATION_MODE="mock"

# Zwapgrid data classification: mock, test, or live
ZWAPGRID_MODE="mock"
# Required in live mode; prevents accidental production accounting access
ZWAPGRID_LIVE_ENABLED="false"
