# Settlement Network - Environment Variables
# Copy to .env and fill in real values

# Database
DATABASE_URL="file:./dev.db"

# Zwapgrid API
ZWAPGRID_API_KEY="your-zwapgrid-api-key-here"
ZWAPGRID_CONSENT_ID=""

# Open Payments (PSD2)
OPEN_PAYMENT_CLIENT_ID="your-client-id-here"
OPEN_PAYMENT_CLIENT_SECRET="your-client-secret-here"
OPEN_PAYMENT_AUTH_HOST="auth.openbankingplatform.com"
OPEN_PAYMENT_API_HOST="api.openbankingplatform.com"

# Integration mode: 'mock' or 'real'
INTEGRATION_MODE="mock"
